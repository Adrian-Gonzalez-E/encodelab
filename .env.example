# Copia a .env y ajusta.

# Directorio con tus vídeos (se monta en solo lectura). Obligatorio.
MEDIA_PATH=/ruta/a/tus/videos
# Dónde guardar la base de datos y los fotogramas de comparación.
DATA_PATH=./data
# Usuario y grupo con los que corre la app (deben poder leer MEDIA_PATH y escribir DATA_PATH): `id`.
PUID=1000
PGID=1000
# Zona horaria (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TZ=Etc/UTC
# Puerto local (solo 127.0.0.1).
PORT=8080
# Hilos de libvmaf; vacío = todas las CPU.
VMAF_THREADS=
# Versión de la imagen (latest o, por ejemplo, 0.1.0).
ENCODELAB_TAG=latest

# Solo con compose.qsv.yaml:
# GID del grupo render del host: `getent group render | cut -d: -f3`.
RENDER_GID=
# Nodo de la GPU Intel que usará QSV.
QSV_DEVICE=/dev/dri/renderD128
